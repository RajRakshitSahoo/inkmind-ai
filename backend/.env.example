# Copy this file to .env and adjust as needed.
# The app runs fully in demo mode with NO values set below.

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string

# --- Database (SQLite by default, zero setup) ---
DATABASE_URL=sqlite:///./inkmind.db

# --- OCR ---
# "tesseract" = use local pytesseract (install the Tesseract binary — see README)
# "demo"      = always return bundled sample text, no install needed
OCR_BACKEND=tesseract

# --- LLM / AI understanding ---
# Leave LLM_API_KEY empty to run in demo/fallback mode (no key required).
# Set it to enable real AI correction, summaries, questions, and chat.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
